#!/bin/bash
# factory: Game engine build and test CLI

set -e

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DEBUG="$PROJECT_DIR/cmake-build-debug"
BUILD_RELEASE="$PROJECT_DIR/cmake-build-release"

cmd_build() {
    local build_type="${1:-debug}"
    local build_dir

    if [ "$build_type" = "debug" ]; then
        build_dir="$BUILD_DEBUG"
        cmake_type="Debug"
    elif [ "$build_type" = "release" ]; then
        build_dir="$BUILD_RELEASE"
        cmake_type="Release"
    else
        echo "Usage: factory build {debug|release}"
        exit 1
    fi

    echo "Building ($build_type)..."
    cmake -S "$PROJECT_DIR" -B "$build_dir" -DCMAKE_BUILD_TYPE="$cmake_type"
    cmake --build "$build_dir"
    echo "✅ Build complete: $build_dir/nayla_game_engine"
}

cmd_test() {
    local test_type="${1:-all}"
    local build_dir="$BUILD_DEBUG"

    if [ ! -d "$build_dir" ]; then
        echo "Build directory not found. Run 'factory build debug' first."
        exit 1
    fi

    case "$test_type" in
        unit)
            echo "Running unit tests..."
            ctest --test-dir "$build_dir" -R "^unit/" -V
            ;;
        contract)
            echo "Running contract tests..."
            ctest --test-dir "$build_dir" -R "^contract/" -V
            ;;
        integration)
            echo "Running integration tests..."
            ctest --test-dir "$build_dir" -R "^integration/" -V || true
            ;;
        architecture)
            echo "Running architecture tests..."
            ctest --test-dir "$build_dir" -R "^architecture/" -V
            ;;
        all)
            echo "Running all tests..."
            ctest --test-dir "$build_dir" -V
            ;;
        *)
            echo "Usage: factory test {unit|contract|integration|architecture|all}"
            exit 1
            ;;
    esac
}

cmd_clean() {
    echo "Cleaning build directories..."
    rm -rf "$BUILD_DEBUG" "$BUILD_RELEASE"
    echo "✅ Clean complete"
}

cmd_status() {
    echo "=== Factory Status ==="
    echo ""
    echo "Project directory: $PROJECT_DIR"
    echo ""

    if [ -d "$BUILD_DEBUG" ]; then
        echo "✓ Debug build exists: $BUILD_DEBUG"
        if [ -f "$BUILD_DEBUG/nayla_game_engine" ]; then
            echo "  Executable: $BUILD_DEBUG/nayla_game_engine"
        fi
    else
        echo "✗ Debug build not found"
    fi

    if [ -d "$BUILD_RELEASE" ]; then
        echo "✓ Release build exists: $BUILD_RELEASE"
        if [ -f "$BUILD_RELEASE/nayla_game_engine" ]; then
            echo "  Executable: $BUILD_RELEASE/nayla_game_engine"
        fi
    else
        echo "✗ Release build not found"
    fi

    echo ""
    echo "Usage:"
    echo "  factory build {debug|release}"
    echo "  factory test {unit|contract|integration|architecture|all}"
    echo "  factory clean"
    echo "  factory status"
}

cmd_search() {
    if [ -z "$1" ]; then
        echo "Usage: factory search <pattern>"
        exit 1
    fi
    grep -r "$1" "$PROJECT_DIR/src" "$PROJECT_DIR/tests" 2>/dev/null || echo "No matches found"
}

cmd_inspect() {
    if [ -z "$1" ]; then
        echo "Usage: factory inspect <path>"
        exit 1
    fi
    echo "Inspecting: $1"
    if [ -f "$1" ]; then
        head -20 "$1"
    elif [ -d "$1" ]; then
        ls -la "$1"
    else
        echo "Not found: $1"
        exit 1
    fi
}

# Main
case "${1:-status}" in
    build)
        cmd_build "$2"
        ;;
    test)
        cmd_test "$2"
        ;;
    clean)
        cmd_clean
        ;;
    status)
        cmd_status
        ;;
    search)
        cmd_search "$2"
        ;;
    inspect)
        cmd_inspect "$2"
        ;;
    *)
        echo "Usage: factory {build,test,clean,status,search,inspect}"
        exit 1
        ;;
esac
