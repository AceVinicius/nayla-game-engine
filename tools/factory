#!/bin/bash
# factory: agent-facing build, test and PR commands with short output.
# Contract: .claude/rules/tooling.md. Every command prints a summary, not logs.

set -uo pipefail

# FACTORY_ROOT points the commands at another checkout (used by `check --ref`).
PROJECT_DIR="${FACTORY_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
BUILD_DEBUG="$PROJECT_DIR/cmake-build-debug"
BUILD_RELEASE="$PROJECT_DIR/cmake-build-release"
REPO="${FACTORY_REPO:-AceVinicius/nayla-game-engine}"

die() { echo "factory: $*" >&2; exit 2; }

build_dir() {
    case "$1" in
        debug) echo "$BUILD_DEBUG" ;;
        release) echo "$BUILD_RELEASE" ;;
        *) die "build type must be debug or release" ;;
    esac
}

cmake_type() { [ "$1" = debug ] && echo Debug || echo Release; }

# Ninja has exact timestamps; Makefiles compare at 1-second resolution, which
# lets a fast edit-and-revert leave stale binaries. An existing build directory
# keeps the generator it was configured with.
configure() {
    local type="$1" dir; dir="$(build_dir "$type")"
    local gen=()
    if [ ! -f "$dir/CMakeCache.txt" ] && command -v ninja >/dev/null 2>&1; then
        gen=(-G Ninja)
    fi
    # Returns (never exits): a configure-time check firing is a result that
    # `prove` and `check` must report, not a reason to abort.
    local log; log="$(mktemp)" || return 1
    cmake -S "$PROJECT_DIR" -B "$dir" ${gen[@]+"${gen[@]}"} \
        -DCMAKE_BUILD_TYPE="$(cmake_type "$type")" \
        -DCMAKE_COMPILE_WARNING_AS_ERROR=ON >"$log" 2>&1
    local rc=$?
    [ $rc -eq 0 ] || { echo "configure ($type) failed:"; grep -E 'Error|error' "$log" | head -10; }
    rm -f "$log"
    return $rc
}

uses_make() { grep -q 'CMAKE_GENERATOR:INTERNAL=Unix Makefiles' "$(build_dir "$1")/CMakeCache.txt" 2>/dev/null; }

# Builds and prints only warning/error lines. Returns the build's status.
build() {
    local type="$1" clean="${2:-}" dir; dir="$(build_dir "$type")"
    configure "$type" || return 1
    local args=(--build "$dir")
    [ "$clean" = clean ] && args+=(--clean-first)
    local log; log="$(mktemp)"
    cmake "${args[@]}" >"$log" 2>&1; local rc=$?
    diagnostics "$log" | head -20
    rm -f "$log"
    return $rc
}

# Diagnostic lines only: compiler/linker messages, FAILED targets, and each
# "ERROR:" block from the build-time checks (cmake/forbid-pattern.sh) with the
# lines it quotes. Drops compiler command lines (they contain -Werror),
# "N errors generated." and repeats; paths become repo-relative.
diagnostics() {
    awk -v p="$PROJECT_DIR/" '
        { while ((i = index($0, p)) > 0) $0 = substr($0, 1, i - 1) substr($0, i + length(p)) }
        /^ERROR:/ { block = 5; emit(); next }
        block > 0 && !/^(\[[0-9]|FAILED|ninja|make|gmake)/ { block--; emit(); next }
        { block = 0 }
        /(cc|c\+\+|clang|gcc|g\+\+|cl\.exe|ld)[[:space:]].* -[co][[:space:]]/ { next }
        /^[0-9]+ (warning|error)s? generated/ { next }
        /warning|error|Error|FAILED|Undefined symbols/ { emit() }
        function emit() { if (!seen[$0]++) print }' "$1"
}

# Runs ctest; prints failing tests and their output only.
run_tests() {
    local type="$1" regex="${2:-}" dir; dir="$(build_dir "$type")"
    local args=(--test-dir "$dir" --output-on-failure)
    [ -n "$regex" ] && args+=(-R "$regex")
    local log; log="$(mktemp)"
    ctest "${args[@]}" >"$log" 2>&1; local rc=$?
    if [ $rc -eq 0 ]; then
        grep -E 'tests passed|Skipped' "$log" | tail -3
    else
        grep -vE '^\s*(Start|[0-9]+/[0-9]+ Test .* Passed)' "$log" | tail -40
    fi
    rm -f "$log"
    return $rc
}

cmd_build() {
    local type="${1:-debug}"
    build "$type" && echo "build $type: OK" || { echo "build $type: FAILED"; exit 1; }
}

cmd_test() {
    local kind="${1:-all}" type="${2:-debug}" regex=""
    case "$kind" in
        unit|contract|integration|architecture) regex="^$kind/" ;;
        all) regex="" ;;
        *) die "usage: factory test {unit|contract|integration|architecture|all} [debug|release]" ;;
    esac
    [ -d "$(build_dir "$type")" ] || build "$type" || exit 1
    run_tests "$type" "$regex" || exit 1
}

# The pre-PR gate: both build types, warnings as errors, full ctest.
# `check --ref <ref>` runs it on a temporary detached worktree of <ref>, so a
# reviewer can build a branch without touching any checkout.
cmd_check() {
    if [ $# -gt 0 ]; then
        [ $# -eq 2 ] && [ "$1" = --ref ] && [ -n "$2" ] || die "usage: factory check [--ref <branch|commit>]"
        local tree
        tree="$(mktemp -d)" || die "cannot create a temporary directory"
        git -C "$PROJECT_DIR" worktree add -q --detach "$tree" "$2" 2>/dev/null \
            || { rmdir "$tree"; die "cannot check out $2"; }
        # EXIT also fires on interrupt: the worktree never outlives the command.
        local q; q="$(printf %q "$tree")"
        trap "git -C $(printf %q "$PROJECT_DIR") worktree remove --force $q 2>/dev/null \
            || echo \"warning: could not remove worktree \"$q >&2" EXIT
        echo "ref $2 @ $(git -C "$tree" rev-parse --short HEAD)"
        FACTORY_ROOT="$tree" "${BASH_SOURCE[0]}" check
        exit $?
    fi
    local status=0 type out; out="$(mktemp)"
    for type in debug release; do
        if build "$type" clean && run_tests "$type" >"$out"; then
            echo "$type: OK ($(grep -oE '[0-9]+% tests passed.*' "$out"))"
        else
            echo "$type: FAILED"; cat "$out"; status=1
        fi
    done
    rm -f "$out"
    exit $status
}

# Proves a check bites: back up FILE, run INJECT (a shell command; $F is the
# file), rebuild, run tests matching REGEX, restore and verify the restore.
# Prints CAUGHT (build or test failed) or MISSED (everything still passed).
cmd_prove() {
    [ $# -eq 3 ] || die "usage: factory prove <file> '<inject command using \$F>' <test-regex>"
    local file="$1" inject="$2" regex="$3" type=debug
    [ -f "$file" ] || [ ! -e "$file" ] || die "not a regular file: $file"
    local existed=1 backup out
    backup="$(mktemp)" && out="$(mktemp)" || die "cannot create temp files; nothing was changed"
    if [ -f "$file" ]; then
        cp "$file" "$backup" && cmp -s "$file" "$backup" || die "backup of $file failed; nothing was changed"
    else
        existed=0
    fi
    # Plain cp + touch (never cp -p): the restored file must look newer than
    # the injected objects so any generator rebuilds it. Returns success only
    # when the file is verifiably back to its original state.
    restore() {
        if [ $existed -eq 1 ]; then
            cp "$backup" "$file" && touch "$file" && cmp -s "$file" "$backup"
        else
            rm -f "$file" && [ ! -e "$file" ]
        fi
    }
    # On any abort: restore, keep the backup if the restore cannot be verified.
    abort() {
        trap - EXIT INT TERM
        if restore; then
            rm -f "$backup" "$out"; echo "prove: $1, $file restored" >&2
        else
            echo "prove: $1 and restoring $file FAILED; original kept at $backup" >&2
        fi
        exit "$2"
    }
    trap 'abort "exited early" 2' EXIT
    trap 'abort interrupted 130' INT TERM
    F="$file" bash -c "$inject" || abort "inject command failed" 2
    touch "$file" 2>/dev/null
    local clean=""; uses_make "$type" && clean=clean
    local verdict
    if ! build "$type" "$clean" >"$out" 2>&1; then
        verdict="CAUGHT (build failed)"; head -5 "$out"
    elif ! run_tests "$type" "$regex" >"$out"; then
        verdict="CAUGHT (test failed)"; grep -E '✗|FAILED|Failed' "$out" | head -8
    else
        verdict="MISSED (build and tests still pass)"
    fi
    trap - EXIT INT TERM
    if ! restore; then
        die "restore of $file FAILED: original kept at $backup"
    fi
    rm -f "$backup" "$out"
    build "$type" "$clean" >/dev/null || echo "warning: rebuild after restore failed"
    echo "$verdict"
    [[ "$verdict" == CAUGHT* ]]
}

# gh prints "hint:" blocks on some calls; drop them so they never reach context.
# Exit status is gh's: grep -v finding nothing to print is not a failure.
gh_q() { gh "$@" 2>/dev/null | { grep -vE '^(hint: if you need to wait|    gh event listen|  - (It prints the first event|Add `--timeout`|Events carry no details|It misses changes|See `gh event listen|Event subscriptions are in preview))' || true; }; }

# Waits for every CI check on a PR, requests a Copilot review if none exists,
# then prints the check summary, failing log lines and review comments.
cmd_pr_wait() {
    local pr="${1:-}"; [ -n "$pr" ] || die "usage: factory pr-wait <pr-number>"
    local head n i
    head="$(gh_q pr view "$pr" --repo "$REPO" --json headRefOid -q .headRefOid)"
    [ -n "$head" ] || die "PR $pr not found (or gh is not authenticated)"
    for i in $(seq 1 60); do
        n="$(gh_q api "repos/$REPO/commits/$head/check-runs" -q .total_count)"
        [ "${n:-0}" -ge 1 ] && break; sleep 10
    done
    # Copilot reviews of THIS head commit only; an older review never counts.
    # Prints a count, or nothing if the API call failed.
    copilot_reviews() {
        gh_q api --paginate "repos/$REPO/pulls/$pr/reviews" \
            -q "[.[]|select((.user.login|test(\"copilot\")) and .commit_id == \"$head\")]|length" \
            | awk '{s += $1} END {if (NR) print s}'
    }
    [ "$(copilot_reviews)" = 0 ] && \
        gh pr edit "$pr" --repo "$REPO" --add-reviewer copilot-pull-request-reviewer >/dev/null 2>&1
    # Bounded wait (about 40 min): gh's --watch alone can hang on a stuck check.
    # An empty answer (API or network error) is unknown, never PASS.
    local rc=8 states
    for i in $(seq 1 120); do
        states="$(gh_q pr checks "$pr" --repo "$REPO" | awk -F'\t' '{print $2}')"
        if [ -n "$states" ] && ! printf '%s\n' "$states" | grep -qE 'pending|queued|in_progress'; then
            if printf '%s\n' "$states" | grep -qE 'fail|cancel'; then rc=1; else rc=0; fi
            break
        fi
        sleep 20
    done
    local verdict="STILL RUNNING OR UNKNOWN (timed out)"
    [ $rc -eq 0 ] && verdict=PASS
    [ $rc -eq 1 ] && verdict=FAIL
    echo "PR $pr @ ${head:0:7}: checks $verdict"
    gh_q pr checks "$pr" --repo "$REPO" | awk -F'\t' '$2 != "pass" {print "  " $1 ": " $2}'
    if [ $rc -eq 1 ]; then
        local run; run="$(gh_q run list --repo "$REPO" --commit "$head" --workflow CI --limit 1 --json databaseId -q '.[0].databaseId')"
        [ -n "$run" ] && gh_q run view "$run" --repo "$REPO" --log-failed | grep -E 'error|Error|FAILED|✗' | sed 's/^.*Z //' | head -20
    fi
    local reviews=""
    for i in $(seq 1 40); do
        reviews="$(copilot_reviews)"
        case "$reviews" in ''|*[!0-9]*|0) sleep 15 ;; *) break ;; esac
    done
    case "$reviews" in
        ''|*[!0-9]*|0)
            echo "copilot: no review of ${head:0:7} received (timed out or API error)"
            [ $rc -eq 0 ] && rc=9 ;;
        *)
            gh_q api --paginate "repos/$REPO/pulls/$pr/reviews" \
                -q ".[]|select((.user.login|test(\"copilot\")) and .commit_id == \"$head\")|\"copilot: \" + (.body|split(\"\n\")|map(select(test(\"^### \")))|join(\" \"))" ;;
    esac
    gh_q api --paginate "repos/$REPO/pulls/$pr/comments" \
        -q ".[]|select(.in_reply_to_id==null and .commit_id == \"$head\")|\"  [\" + .path + \":\" + ((.line // .original_line)|tostring) + \"] (id \" + (.id|tostring) + \") \" + .body"
    gh_q pr view "$pr" --repo "$REPO" --json mergeStateStatus -q '"merge state: " + .mergeStateStatus'
    # gh pr checks follows the live head; the reviews above are pinned to $head.
    # A push during the wait would mix the two, so success needs the same head.
    local now; now="$(gh_q pr view "$pr" --repo "$REPO" --json headRefOid -q .headRefOid)"
    if [ "$now" != "$head" ]; then
        echo "head changed during the wait (${head:0:7} -> ${now:0:7}, or unknown): rerun pr-wait"
        [ $rc -eq 0 ] && rc=10
    fi
    return $rc
}

# Issue title, state and body only: no comments, no gh hints.
cmd_issue() {
    [ -n "${1:-}" ] || die "usage: factory issue <number>"
    local out
    out="$(gh_q issue view "$1" --repo "$REPO" --json number,title,state,body \
        -q '"#" + (.number|tostring) + " " + .title + " [" + .state + "]\n\n" + .body')"
    [ -n "$out" ] || die "issue $1 not found (or gh is not authenticated)"
    printf '%s\n' "$out"
}

# Unresolved, non-outdated review threads on a PR: path:line, author, first
# comment. Resolved and outdated threads are noise for whoever fixes them.
cmd_pr_comments() {
    [ -n "${1:-}" ] || die "usage: factory pr-comments <pr-number>"
    local out
    # shellcheck disable=SC2016 # GraphQL variables, not shell
    out="$(gh_q api graphql -F owner="${REPO%/*}" -F name="${REPO#*/}" -F pr="$1" -f query='
        query($owner: String!, $name: String!, $pr: Int!) {
          repository(owner: $owner, name: $name) { pullRequest(number: $pr) {
            reviewThreads(first: 100) { pageInfo { hasNextPage } nodes {
              isResolved isOutdated path line originalLine
              comments(first: 1) { nodes { databaseId author { login } body } } } } } } }' \
        -q '.data.repository.pullRequest.reviewThreads as $t
            | ($t.nodes[] | select((.isResolved or .isOutdated) | not)
               | .comments.nodes[0] as $c
               | "[" + .path + ":" + ((.line // .originalLine)|tostring) + "] (id "
                 + ($c.databaseId|tostring) + ", " + $c.author.login + ") " + $c.body),
              (if $t.pageInfo.hasNextPage then "WARNING: more than 100 threads; only the first 100 were checked" else empty end)')" \
        || die "PR $1 not found (or gh is not authenticated)"
    [ -n "$out" ] && printf '%s\n' "$out" || echo "PR $1: no unresolved review threads"
}

cmd_status() {
    local type dir
    for type in debug release; do
        dir="$(build_dir "$type")"
        if [ -f "$dir/CMakeCache.txt" ]; then
            echo "$type: configured ($(sed -n 's/^CMAKE_GENERATOR:INTERNAL=//p' "$dir/CMakeCache.txt"))"
        else
            echo "$type: not configured"
        fi
    done
    command -v ninja >/dev/null 2>&1 && echo "ninja: yes" || echo "ninja: no (Makefiles; see rules/tooling.md)"
    echo "branch: $(git -C "$PROJECT_DIR" rev-parse --abbrev-ref HEAD)  $(git -C "$PROJECT_DIR" status --short | wc -l | tr -d ' ') changed file(s)"
}



# Rule definitions in docs/ are paragraphs that start with `**<ID>`, e.g.
# `**PLAT-INV-3.**` or `**CORE-LOG-010 (title).**`.

# Prints each rule's definition: from its `**<ID>` line up to the next rule
# definition or heading, so lists and code blocks that belong to it come along.
cmd_rule() {
    [ $# -ge 1 ] || die "usage: factory rule <ID>... (e.g. PLAT-INV-3 CORE-LOG-010)"
    local files=() f id status=0
    # An array (bash 3.2 has no mapfile): the checkout path may contain spaces.
    while IFS= read -r f; do files+=("$f"); done < <(find "$PROJECT_DIR/docs" -name '*.md' | sort)
    [ ${#files[@]} -gt 0 ] || die "no docs/**/*.md under $PROJECT_DIR"
    for id in "$@"; do
        awk -v id="$id" -v root="$PROJECT_DIR/" '
            FNR == 1 { on = 0; code = 0; blanks = 0 }
            {
                fence = ($0 ~ /^```/)
                if (!code) {
                    head = "**" id
                    if (substr($0, 1, length(head)) == head &&
                        substr($0, length(head) + 1, 1) !~ /[A-Za-z0-9-]/) {
                        if (found++) print ""
                        f = FILENAME
                        if (index(f, root) == 1) f = substr(f, length(root) + 1)
                        print f ":" FNR; on = 1; blanks = 0
                    } else if (on && ($0 ~ /^\*\*[A-Z]+(-[A-Z]+)*-[0-9]/ || $0 ~ /^#/)) on = 0
                }
                if (on) {
                    if ($0 == "") blanks++
                    else { for (; blanks > 0; blanks--) print ""; print }
                }
                if (fence) code = !code
            }
            END { exit found ? 0 : 1 }' "${files[@]}" || { echo "$id: not found"; status=1; }
    done
    return $status
}

# Prints a spec's headings with line numbers and the rule IDs each section
# defines, so an agent can read one section or rule instead of the whole file.
cmd_toc() {
    [ -f "${1:-}" ] || die "usage: factory toc <spec.md>"
    awk '
        function flush() {
            if (h == "") return
            line = sprintf("%5d  %s", hl, h)
            if (n == 1) line = line "  [" first "]"
            if (n > 1) line = line "  [" first " .. " last ", " n " rules]"
            print line
        }
        /^```/ { code = !code }
        !code && /^##?#?#? / { flush(); h = $0; hl = NR; n = 0; next }
        !code && match($0, /^\*\*[A-Z]+(-[A-Z]+)*-[0-9]/) {
            id = substr($0, 3); sub(/[^A-Za-z0-9-].*/, "", id)
            if (!n++) first = id
            last = id
        }
        END { flush() }' "$1"
}

case "${1:-status}" in
    build) shift; cmd_build "$@" ;;
    test) shift; cmd_test "$@" ;;
    check) shift; cmd_check "$@" ;;
    rule) shift; cmd_rule "$@" ;;
    toc) shift; cmd_toc "$@" ;;
    prove) shift; cmd_prove "$@" ;;
    pr-wait) shift; cmd_pr_wait "$@" ;;
    pr-comments) shift; cmd_pr_comments "$@" ;;
    issue) shift; cmd_issue "$@" ;;
    status) cmd_status ;;
    *) die "usage: factory {check [--ref <ref>]|prove|pr-wait|pr-comments|issue|rule|toc|build|test|status}" ;;
esac
