# ------------------------------------------------------------

*.dmp
*.core
/core
core.*
crash/
crashes/

# ------------------------------------------------------------
# GPU / graphics debugging artifacts
# ------------------------------------------------------------

# RenderDoc
*.rdc

# PIX
*.wpix

# Nsight
*.nsight-capture
*.nsight-gfx-capture

# Xcode GPU captures
*.gputrace

# Vulkan validation / layer logs
vk_layer_settings.txt
vulkan.log

# Shader compiler temporary output
*.spv.tmp
*.shader.tmp
shader-cache/
shader-cache-*/

# ------------------------------------------------------------
# Generated shader binaries
# ------------------------------------------------------------

# If shaders are source-of-truth assets, generated binaries
# should generally not be committed.

*.spv
*.dxil
*.cso
*.metallib

