# ============================================================
# Portable Game Engine
# Root .gitignore
# ============================================================

# ------------------------------------------------------------
# OS / Filesystem
# ------------------------------------------------------------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

Thumbs.db
ehthumbs.db
Desktop.ini

$RECYCLE.BIN/

# ------------------------------------------------------------
# Editors / IDEs
# ------------------------------------------------------------

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Xcode
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# CLion
cmake-build-*/

# Vim
*.swp
*.swo
*~
*.vim_runtime

# Emacs
.#*
\#*\#
*.elc

# ------------------------------------------------------------
# Claude / AI runtime artifacts
# ------------------------------------------------------------

# Keep the project's authored Claude configuration tracked:
#   .claude/CLAUDE.md
#   .claude/agents/
#   .claude/rules/
#   .claude/workflows/
#
# Ignore only local/runtime state.

.claude/local/
.claude/cache/
.claude/tmp/
.claude/logs/
.claude/runtime/
.claude/worktrees/

# Local AI-generated scratch files
.ai/
.ai-cache/
.ai-tmp/

# ------------------------------------------------------------
# Build directories
# ------------------------------------------------------------

build/
build-*/
out/
out-*/
dist/
bin/
obj/
lib/
Debug/
Release/
RelWithDebInfo/
MinSizeRel/

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
install_manifest.txt
compile_commands.json

# CMake generated directories/files
cmake-build-*/
_cmake/
CMakeUserPresets.json

# Ninja
.ninja_deps
.ninja_log

# Meson
.meson/
meson-private/
meson-logs/
meson-info/

