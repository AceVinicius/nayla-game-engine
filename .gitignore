*.idb

# Precompiled headers
*.gch
*.pch

# Coverage
*.gcda
*.gcno
*.gcov
coverage/
coverage-*/

# ------------------------------------------------------------
# CMake local configuration
# ------------------------------------------------------------

CMakeUserPresets.json

# Keep repository presets tracked:
# CMakePresets.json

