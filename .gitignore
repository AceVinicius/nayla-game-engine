# ------------------------------------------------------------

site/
public/
docs/_build/
docs/build/
docs/site/
docs/.cache/

# Keep authored documentation:
# docs/spec/
# docs/architecture/
# docs/adr/

# ------------------------------------------------------------
# Task system
# ------------------------------------------------------------

# Keep task definitions/state tracked:
# tasks/backlog/
# tasks/ready/
# tasks/active/
# tasks/review/
# tasks/changes_requested/
# tasks/done/

# Ignore temporary task artifacts
tasks/.cache/
tasks/.tmp/
tasks/tmp/
tasks/generated/

# ------------------------------------------------------------
# Generated reports
# ------------------------------------------------------------

reports/
reports/generated/
reports/tmp/

# ------------------------------------------------------------
# Archives generated locally
# ------------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

