# ------------------------------------------------------------

# vcpkg
.vcpkg/
vcpkg_installed/

# Conan
.conan/
conan.lock
conanbuild.*
conaninfo.*
conanmanifest.txt
conan_data.yml
conan_home/

# FetchContent / downloaded dependencies
_deps/
deps/_build/
third_party/_build/

# ------------------------------------------------------------
# Package / dependency caches
# ------------------------------------------------------------

.cache/
.cache-*/
tmp/
temp/

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log
*.log.*
logs/

# Keep intentional documentation examples/log fixtures by
# explicitly force-adding them if necessary.

